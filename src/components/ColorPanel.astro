---
// Dev-only colour playground. Rendered by BaseLayout only when running `astro dev`,
// so it never ships in the built site. Edits are saved in localStorage.

const vars = [
	['page', 'Around the window'],
	['background', 'Content'],
	['sidebar', 'Sidebar'],
	['border', 'Borders'],
	['window-border', 'Window border'],
	['text', 'Text'],
	['text-muted', 'Muted text'],
	['hover', 'Hover'],
	['active', 'Active / current'],
	['button', 'Button'],
	['button-hover', 'Button hover'],
	['button-border', 'Button border'],
	['button-icon', 'Button icon'],
	['arrows', 'Hover arrows'],
	['focus', 'Focus ring'],
];
---

<div class="color-panel" transition:persist data-collapsed>
	<button class="toggle" type="button">Colours</button>
	<div class="body">
		<label class="row preset-row">
			<span>Preset</span>
			<select class="preset"></select>
		</label>
		{vars.map(([name, label]) => (
			<label class="row">
				<span>{label}</span>
				<input type="color" data-var={name} />
				<input type="text" data-hex={name} spellcheck="false" />
			</label>
		))}
		<div class="sky-section">
			<label class="row wide-row">
				<span>Sky background</span>
				<input type="checkbox" class="sky-on" />
			</label>
			<label class="row wide-row">
				<span>Coverage</span>
				<input type="range" class="sky-coverage" min="0" max="1" step="0.01" />
			</label>
			<label class="row wide-row">
				<span>Wind</span>
				<input type="range" class="sky-wind" min="0" max="1" step="0.01" />
			</label>
			<label class="row wide-row">
				<span>Blur</span>
				<input type="range" class="sky-blur" min="0" max="40" step="1" />
			</label>
		</div>
		<div class="actions">
			<button type="button" class="copy">Copy CSS</button>
			<button type="button" class="reset">Reset</button>
		</div>
	</div>
</div>

<style>
	/* Deliberately fixed styling so the panel isn't affected by the colours it edits */
	.color-panel {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 1000;
		width: 15rem;
		max-height: calc(100vh - 2rem);
		overflow-y: auto;
		background: #1c1c1e;
		color: #eee;
		border: 1px solid #333;
		border-radius: 0.5rem;
		box-shadow: 0 4px 16px rgb(0 0 0 / 0.25);
		font: 500 0.75rem/1.2 'Inter Variable', system-ui, sans-serif;
	}

	.color-panel[data-collapsed] {
		width: auto;
	}

	.color-panel[data-collapsed] .body {
		display: none;
	}

	button,
	select,
	input[type='text'] {
		font: inherit;
		color: #eee;
		background: #2c2c2e;
		border: 1px solid #3a3a3c;
		border-radius: 0.25rem;
	}

	button {
		cursor: pointer;
		padding: 0.25rem 0.5rem;
	}

	button:hover {
		background: #3a3a3c;
	}

	.toggle {
		display: block;
		width: 100%;
		border: none;
		background: transparent;
		padding: 0.5rem 0.75rem;
		text-align: left;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0 0.75rem 0.75rem;
	}

	.row {
		display: grid;
		grid-template-columns: 1fr 1.5rem 4.5rem;
		align-items: center;
		gap: 0.375rem;
	}

	.sky-section {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: 0.5rem;
		padding-top: 0.5rem;
		border-top: 1px solid #333;
	}

	.wide-row {
		grid-template-columns: 1fr 8rem;
	}

	.wide-row input {
		justify-self: start;
		margin: 0;
	}

	.wide-row input[type='range'] {
		width: 100%;
	}

	.preset-row {
		grid-template-columns: 1fr 8rem;
		margin-bottom: 0.25rem;
	}

	input[type='color'] {
		width: 1.5rem;
		height: 1.5rem;
		padding: 0;
		border: 1px solid #3a3a3c;
		border-radius: 0.25rem;
		background: none;
		cursor: pointer;
	}

	input[type='text'] {
		width: 100%;
		padding: 0.2rem 0.3rem;
		font-family: ui-monospace, monospace;
	}

	.actions {
		display: flex;
		gap: 0.375rem;
		margin-top: 0.5rem;
	}

	.actions button {
		flex: 1;
	}
</style>

<script>
	type Scheme = Record<string, string>;

	const PRESETS: Record<string, Scheme> = {
		'Current mint': {},
		'Paper + mint accent': {
			page: '#ffffff', background: '#faf9f7', sidebar: '#f1efeb', border: '#e2dfd9',
			'window-border': '#e8e5e0', text: '#1c1a17', 'text-muted': '#8a857d',
			hover: '#e3efe9', active: '#d3e8de', button: '#f1efeb', 'button-hover': '#e8e5e0', 'button-border': '#d6d2cb',
			'button-icon': '#6f6a63', 'arrows': '#2b5042',
		},
		'Forest (dark)': {
			page: '#0f1612', background: '#1b2821', sidebar: '#16211b', border: '#2a3a31',
			'window-border': '#2a3a31', text: '#e6efe9', 'text-muted': '#8fa198',
			hover: '#24352c', active: '#2d4237', button: '#23322a', 'button-hover': '#2b3d33', 'button-border': '#34473c',
			'button-icon': '#a7b8af', 'arrows': '#3e5a4b',
		},
		'Mint, fixed': {
			page: '#ffffff', background: '#f7faf8', sidebar: '#e0efe8', border: '#c9d7d1',
			'window-border': '#e1ebe6', text: '#14201a', 'text-muted': '#7b8a83',
			hover: '#c7e2d6', active: '#aed6c4', button: '#e6eae8', 'button-hover': '#dbe2df', 'button-border': '#bcccc6',
			'button-icon': '#66756e', 'arrows': '#2b5042',
		},
		'Light blue': {
			page: '#ffffff', background: '#f2f6fb', sidebar: '#e0eaf5', border: '#c9d4e0',
			'window-border': '#e1e8f0', text: '#1c2433', 'text-muted': '#7f8794',
			hover: '#c9dbee', active: '#b0cbe6', button: '#e6eaef', 'button-hover': '#dbe2ea',
			'button-border': '#bcc8d6', 'button-icon': '#6b7380', 'arrows': '#2b4466', focus: '#0062c4',
		},
	};

	const KEY = 'color-panel';
	const root = document.documentElement;
	const panel = document.querySelector<HTMLElement>('.color-panel')!;
	const preset = panel.querySelector<HTMLSelectElement>('.preset')!;
	const names = Array.from(panel.querySelectorAll<HTMLInputElement>('input[data-var]'), (p) => p.dataset.var!);

	// Defaults come from the :root block in BaseLayout, read before any overrides apply.
	const defaults: Scheme = {};
	for (const n of names) defaults[n] = getComputedStyle(root).getPropertyValue(`--${n}`).trim();
	PRESETS['Current mint'] = { ...defaults };

	let overrides: Scheme = JSON.parse(localStorage.getItem(KEY) || '{}');

	function apply() {
		for (const n of names) {
			if (overrides[n]) root.style.setProperty(`--${n}`, overrides[n]);
			else root.style.removeProperty(`--${n}`);
		}
	}

	function save() {
		localStorage.setItem(KEY, JSON.stringify(overrides));
		apply();
		sync();
	}

	function sync() {
		for (const n of names) {
			const value = overrides[n] || defaults[n];
			panel.querySelector<HTMLInputElement>(`[data-var="${n}"]`)!.value = value;
			const hex = panel.querySelector<HTMLInputElement>(`[data-hex="${n}"]`)!;
			if (document.activeElement !== hex) hex.value = value;
		}
		const match = Object.entries(PRESETS).find(([, s]) => names.every((n) => (overrides[n] || defaults[n]) === (s[n] || defaults[n])));
		preset.value = match ? match[0] : 'Custom';
	}

	function set(name: string, value: string) {
		if (value === defaults[name]) delete overrides[name];
		else overrides[name] = value;
		save();
	}

	for (const name of [...Object.keys(PRESETS), 'Custom']) {
		const option = new Option(name, name);
		if (name === 'Custom') option.disabled = true;
		preset.add(option);
	}

	preset.addEventListener('change', () => {
		const scheme = PRESETS[preset.value];
		overrides = {};
		for (const n of names) if (scheme[n] && scheme[n] !== defaults[n]) overrides[n] = scheme[n];
		save();
	});

	panel.addEventListener('input', (e) => {
		const el = e.target as HTMLInputElement;
		if (el.dataset.var) set(el.dataset.var, el.value);
		const hex = el.value.trim().toLowerCase();
		if (el.dataset.hex && /^#[0-9a-f]{6}$/.test(hex)) set(el.dataset.hex, hex);
	});

	panel.querySelector('.toggle')!.addEventListener('click', () => panel.toggleAttribute('data-collapsed'));

	panel.querySelector('.reset')!.addEventListener('click', () => {
		overrides = {};
		save();
	});

	panel.querySelector('.copy')!.addEventListener('click', async (e) => {
		const css = names.map((n) => `\t\t--${n}: ${overrides[n] || defaults[n]};`).join('\n');
		await navigator.clipboard.writeText(`\t:root {\n${css}\n\t}`);
		const btn = e.currentTarget as HTMLButtonElement;
		btn.textContent = 'Copied!';
		setTimeout(() => (btn.textContent = 'Copy CSS'), 1200);
	});

	// Page navigation replaces the <html> element's attributes, so re-apply after every swap.
	document.addEventListener('astro:after-swap', apply);

	apply();
	sync();

	// --- Sky background controls ---
	const SKY_KEY = 'color-panel-sky';
	const sky = () => document.querySelector<HTMLCanvasElement>('canvas.sky');
	const skyOn = panel.querySelector<HTMLInputElement>('.sky-on')!;
	const skyCoverage = panel.querySelector<HTMLInputElement>('.sky-coverage')!;
	const skyWind = panel.querySelector<HTMLInputElement>('.sky-wind')!;
	const skyBlur = panel.querySelector<HTMLInputElement>('.sky-blur')!;
	const SKY_DEFAULTS = { on: true, coverage: sky()?.dataset.coverage ?? '0.5', wind: sky()?.dataset.wind ?? '0.15', blur: '0' };
	let skyState = { ...SKY_DEFAULTS, ...JSON.parse(localStorage.getItem(SKY_KEY) || '{}') };

	function applySky() {
		const canvas = sky();
		if (canvas) {
			canvas.hidden = !skyState.on;
			canvas.dataset.coverage = skyState.coverage;
			canvas.dataset.wind = skyState.wind;
			canvas.style.setProperty('--blur', `${skyState.blur}px`);
			dispatchEvent(new Event('resize')); // canvas size depends on the blur
		}
		skyOn.checked = skyState.on;
		skyCoverage.value = skyState.coverage;
		skyWind.value = skyState.wind;
		skyBlur.value = skyState.blur;
		skyBlur.title = `${skyState.blur}px`;
	}

	function saveSky() {
		localStorage.setItem(SKY_KEY, JSON.stringify(skyState));
		applySky();
	}

	skyOn.addEventListener('change', () => { skyState.on = skyOn.checked; saveSky(); });
	skyCoverage.addEventListener('input', () => { skyState.coverage = skyCoverage.value; saveSky(); });
	skyWind.addEventListener('input', () => { skyState.wind = skyWind.value; saveSky(); });
	skyBlur.addEventListener('input', () => { skyState.blur = skyBlur.value; saveSky(); });
	panel.querySelector('.reset')!.addEventListener('click', () => { skyState = { ...SKY_DEFAULTS }; saveSky(); });
	applySky();
</script>
