---
import { Image } from 'astro:assets';

interface Props {
	label?: string;
	/** Optional icon image shown in the box (otherwise a plain placeholder box). */
	icon?: ImageMetadata;
	/** id of the window this icon opens */
	opens?: string;
	/** if set, the icon is a link to another desktop instead of a window opener */
	href?: string;
	/** shared view-transition-name for a morph into the linked desktop */
	transitionName?: string;

	/* Placement — anchor to any edge(s) with these, OR float near the
	   center with `center={[dx, dy]}` (px offset from the viewport middle). */
	top?: string;
	right?: string;
	bottom?: string;
	left?: string;
	center?: [number, number];
}

const { label = '', icon, opens, href, transitionName, top, right, bottom, left, center } =
	Astro.props;

const boxStyle = transitionName ? `view-transition-name: ${transitionName}` : undefined;

let placement: string;
if (center) {
	const [dx, dy] = center;
	placement = `left: 50%; top: 50%; transform: translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px));`;
} else {
	placement = [
		top && `top: ${top}`,
		right && `right: ${right}`,
		bottom && `bottom: ${bottom}`,
		left && `left: ${left}`,
	]
		.filter(Boolean)
		.join('; ');
}
---

<div class="desktop-icon" style={placement}>
	{
		href ? (
			<a class="desktop-icon__hit" href={href}>
				<span class="desktop-icon__box" style={boxStyle}>
					{icon && (
						<Image src={icon} alt="" width={128} height={128} class="desktop-icon__img" />
					)}
				</span>
				<span class="desktop-icon__label">{label}</span>
			</a>
		) : (
			<button class="desktop-icon__hit" type="button" data-opens={opens}>
				<span class="desktop-icon__box" style={boxStyle}>
					{icon && (
						<Image src={icon} alt="" width={128} height={128} class="desktop-icon__img" />
					)}
				</span>
				<span class="desktop-icon__label">{label}</span>
			</button>
		)
	}
</div>

<style>
	.desktop-icon {
		position: fixed;
	}

	/* The whole icon (box + label) is one hit target, like the nested-desktop
	   icons — clicking the label works too. */
	.desktop-icon__hit {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;

		padding: 6px;
		background: none;
		border: none;
		border-radius: 8px;
		color: inherit;
		font: inherit;
		text-decoration: none;
	}

	.desktop-icon__box {
		display: block;
		width: 64px;
		height: 64px;

		/* Cream box; shows a clipped icon image when one is provided. */
		background: var(--window-bg);
		border: 3px solid var(--window-border);
		border-radius: 12px;
		overflow: hidden;

		transition: border-color 120ms ease, box-shadow 120ms ease;
	}

	.desktop-icon__hit:hover .desktop-icon__box {
		border-color: var(--window-bar);
		box-shadow: 0 0 0 3px rgba(106, 122, 78, 0.18);
	}

	.desktop-icon__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.desktop-icon__label {
		font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace;
		font-size: 18px;
		color: var(--ink);
		text-align: center;
	}
</style>
