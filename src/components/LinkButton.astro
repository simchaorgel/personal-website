---
interface Props {
	href: string;
	label: string;
	/** Raw SVG markup (e.g. a Tabler icon imported with ?raw) */
	icon: string;
	/** 'large' for the bigger buttons in the project page header */
	size?: 'normal' | 'large';
}

const { href, label, icon, size = 'normal' } = Astro.props;
---

<a class:list={['link-button', size]} href={href} target="_blank" rel="noopener noreferrer">
	<span class="icon" aria-hidden="true" set:html={icon} />
	{label}
</a>

<style>
	.link-button {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		height: 1.75rem;
		padding: 0 0.625rem 0 0.5rem;
		background: var(--button);
		border: 1px solid var(--button-border);
		border-radius: 0.375rem;
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
		color: var(--text);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		vertical-align: middle;
		transition: background-color 120ms ease-out;
	}

	.link-button:hover {
		background: var(--button-hover);
	}

	.link-button.large {
		gap: 0.5rem;
		height: 2.25rem;
		padding: 0 0.875rem 0 0.75rem;
		border-radius: 0.5rem;
		font-size: 0.9375rem;
	}

	.icon {
		display: flex;
		color: var(--button-icon);
	}

	.icon :global(svg) {
		width: 1rem;
		height: 1rem;
	}

	.large .icon :global(svg) {
		width: 1.125rem;
		height: 1.125rem;
	}
</style>
