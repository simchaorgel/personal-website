---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	href: string;
	title: string;
	description?: string;
	/** An image (project icon), or raw SVG markup for a plain glyph tile (e.g. a Tabler icon ?raw) */
	icon: ImageMetadata | string;
	/** Show an image icon as-is: no border, not cropped */
	plain?: boolean;
}

const { href, title, description, icon, plain = false } = Astro.props;
---

<a class="card" href={href}>
	{typeof icon === 'string' ? (
		<span class="icon glyph" aria-hidden="true" set:html={icon} />
	) : (
		<Image src={icon} alt="" class:list={['icon', { plain }]} width={96} height={96} />
	)}
	<div class="text">
		<h2 class="title">{title}</h2>
		{description && <p class="description">{description}</p>}
	</div>
</a>

<style>
	.card {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem;
		background: var(--button);
		border: 1px solid var(--button-border);
		border-radius: 0.5rem;
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
		text-decoration: none;
		transition: background-color 120ms ease-out;
	}

	.card:hover {
		background: var(--button-hover);
	}

	.icon {
		flex: none;
		width: 3rem;
		height: 3rem;
		object-fit: cover;
		border: 1px solid var(--button-border);
		border-radius: 0.375rem;
	}

	.plain {
		object-fit: contain;
		border: none;
		border-radius: 0;
	}

	.glyph {
		display: grid;
		place-items: center;
		background: var(--background);
		color: var(--button-icon);
	}

	.glyph :global(svg) {
		width: 1.5rem;
		height: 1.5rem;
	}

	.text {
		min-width: 0;
	}

	.title {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.3;
		color: var(--text);
	}

	.description {
		margin: 0.25rem 0 0;
		font-size: 0.875rem;
		color: var(--text-muted);
	}
</style>
