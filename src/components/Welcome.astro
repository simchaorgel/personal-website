<style>
	.about {
		height: 100%;
		box-sizing: border-box;
		padding: 20px;

		display: flex;
		align-items: center;
		gap: 24px;
	}

	.about__avatar {
		flex: none;
		width: 150px;
		height: 150px;
		border-radius: 50%;

		background-color: var(--grid-line); /* fallback while image is missing */
		background-image: url('/me.jpg');
		background-size: cover;
		background-position: center;
	}

	.about__intro {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.about__hi {
		margin: 0;
		color: var(--ink);
		font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace;
		font-size: 27px;
		font-weight: 600;

		/* Stretch the single line to fill the column so it matches the stats row */
		text-align: justify;
		text-align-last: justify;
	}

	.about__stats {
		margin: 0;
		padding: 0;
		list-style: none;

		/* The dots are their own list items, so space-between puts an *equal*
		   gap either side of each dot (a ::before dot hangs off the next item
		   and spaces unevenly). */
		display: flex;
		align-items: center;
		justify-content: space-between;

		color: var(--ink-muted);
		font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace;
		font-size: 14px;
	}

	.about__socials {
		display: flex;
		gap: 10px;
	}

	.social {
		width: 36px;
		height: 36px;
		display: grid;
		place-items: center;

		border: none;
		padding: 0;
		border-radius: 8px;
		color: #fff; /* icon color */
		cursor: pointer;

		transition: filter 120ms ease;
	}

	.social:hover {
		filter: brightness(1.08);
	}

	.social svg {
		width: 18px;
		height: 18px;
		fill: currentColor;
		display: block;
	}

	/* Brand backgrounds */
	.social--linkedin {
		background: #007ebb;
	}
	.social--github {
		background: #181717;
	}
	.social--email {
		background: var(--window-bar); /* site olive — ties email to the palette */
	}

	/* Mobile: stack into a centered column — the side-by-side row forced a
	   small, letter-spaced title into the leftover width. */
	@media (max-width: 640px) {
		.about {
			flex-direction: column;
			justify-content: center;
			gap: 18px;
			padding: 24px 20px;
		}
		.about__avatar {
			width: 110px;
			height: 110px;
		}
		.about__intro {
			align-items: center;
			gap: 12px;
		}
		.about__hi {
			font-size: 24px;
			/* No justify-stretch here — centered, naturally spaced */
			text-align: center;
			text-align-last: center;
		}
		.about__stats {
			justify-content: center;
			gap: 10px;
		}
		.about__socials {
			justify-content: center;
		}
	}
</style>
