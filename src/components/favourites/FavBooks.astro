---
// A plain list of favourite books. Order here is the display order — add,
// remove or reorder freely. (The old cover images still live in
// src/assets/favourites/books/ but are no longer used.)
const books: { title: string; author: string }[] = [
	{ title: 'There Is No Antimemetics Division', author: 'qntm' },
	{ title: 'The Last Dragonslayer', author: 'Jasper Fforde' },
	{ title: 'The Constant Rabbit', author: 'Jasper Fforde' },
	{ title: 'Eragon series', author: 'Christopher Paolini' },
	{ title: 'Harry Potter and the Methods of Rationality', author: 'Eliezer Yudkowsky' },
	{ title: 'Project Lawfull', author: 'Iarwain, lintamande' },
	{ title: 'Unsong', author: 'Scott Alexander' },
	{ title: 'The Little Prince', author: 'Antoine de Saint-Exupéry' },
	{ title: 'War and Peace', author: 'Leo Tolstoy' },
	{ title: 'When Breath Becomes Air', author: 'Paul Kalanithi' },
	{ title: 'Sapiens', author: 'Yuval Noah Harari' },
	{ title: 'The Pattern Seekers', author: 'Simon Baron-Cohen' },
	{ title: 'For the Love of Physics', author: 'Walter Lewin' },
	{ title: 'Storm in a Teacup', author: 'Helen Czerski' },
	{ title: 'How Numbers Work', author: 'New Scientist' },
	{ title: 'What If?', author: 'Randall Munroe' },
	{ title: "You Talkin' To Me?", author: 'Sam Leith' },
	{ title: 'Fake Law', author: 'The Secret Barrister' },
];
---

<div class="books">
	<p class="books__intro">
	</p>

	<ul class="books__list">
		{
			books.map((book) => (
				<li class="books__item">
					<span class="books__title">{book.title}</span>
					<span class="books__author"> ({book.author})</span>
				</li>
			))
		}
	</ul>
</div>

<style>
	.books__intro {
		margin: 10px 0 0 0;
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.65;
		color: var(--ink);
		font-weight: 400;
	}

	.books__list {
		margin: 24px 0 10px;
		padding: 0 0 0 20px;
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.5;
		/* A shade darker than --window-bar, which reads washed-out on beige. */
		color: #3f4a33;
	}

	.books__item {
		margin-bottom: 10px;
	}

	.books__item::marker {
		color: #3f4a33;
	}

	.books__title {
		font-weight: 500;
	}

	.books__author {
		opacity: 0.75;
	}

	@media (max-width: 640px) {
		.books__list {
			margin-top: 20px;
			padding-left: 18px;
			font-size: 15px;
		}
	}
</style>
