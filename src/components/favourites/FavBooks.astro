---
import { Image } from 'astro:assets';

// Auto-loads every cover in src/assets/favourites/books/ — just drop an image
// in that folder (named so they sort how you want) and it shows up here.
const modules = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/favourites/books/*.{jpg,jpeg,png,webp,avif}',
	{ eager: true },
);
const covers = Object.entries(modules)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([, m]) => m.default);
---

<div class="books">
	<p class="books__intro">
		These are some book I've enjoyed reading
	</p>

	{
		covers.length > 0 && (
			<div class="books__gallery">
				{covers.map((cover, i) => (
					<span class="books__book">
						<Image src={cover} alt={`Book cover ${i + 1}`} class="books__cover" />
					</span>
				))}
			</div>
		)
	}
</div>

<style>
	.books__intro {
		margin: 10px 0 0 0;
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.65;
		color: var(--ink-muted);
	}

	/* A plain gallery of covers on the window's beige — uniform height rows
	   (bottom-aligned, like books standing together), soft shadows for lift. */
	.books__gallery {
		--cover-h: 200px;

		margin-top: 30px;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		column-gap: 26px;
		row-gap: 34px;
		padding: 0 4px 10px;
	}

	.books__book {
		display: block;
		height: var(--cover-h);
	}

	.books__cover {
		display: block;
		width: auto;
		height: 100%;
		border-radius: 2px;
		box-shadow:
			0 0 0 1px rgba(58, 58, 58, 0.22),
			0 7px 10px -5px rgba(58, 58, 58, 0.4);
	}

	@media (max-width: 640px) {
		.books__gallery {
			--cover-h: 148px;
			column-gap: 16px;
			row-gap: 26px;
			padding: 0 2px 8px;
		}
	}
</style>
