---
// Shown by Netlify for any address that doesn't exist.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" noindex>
	<section class="missing">
		<h1 class="title">p4ge n0t 4ound</h1>
		<div class="actions">
			<a class="button" href="/">Home</a>
			<a class="button" href="/contact">Submit complaint</a>
		</div>
	</section>
</BaseLayout>

<style>
	/* Everything stacked in the middle of the content area */
	.missing {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		height: 100%;
		padding: 3rem;
		text-align: center;
	}

	/* Same look as the homepage title */
	.title {
		margin: 0;
		font-size: 2.5rem;
		font-weight: 300;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}

	/* Grey button, like the others */
	.button {
		display: inline-flex;
		align-items: center;
		height: 2.25rem;
		padding: 0 0.875rem;
		background: var(--button);
		border: 1px solid var(--button-border);
		border-radius: 0.5rem;
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
		color: var(--text);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
		transition: background-color 120ms ease-out;
	}

	.button:hover {
		background: var(--button-hover);
	}

	/* Phone: the window scrolls as a whole, so fill the screen below the nav instead */
	@media (width < 48rem) {
		.missing {
			height: auto;
			min-height: calc(100dvh - 5rem);
			padding: 1.5rem 1.25rem;
		}

		.title {
			font-size: 1.75rem;
		}
	}
</style>
