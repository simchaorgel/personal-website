---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Photography">
	<main class="photography">
		<h1 class="photography__title">Photography</h1>
		<p class="photography__note">A new desktop — coming soon.</p>
	</main>
</Layout>

<style>
	.photography {
		position: fixed;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
		color: var(--ink);
		text-align: center;
	}

	.photography__title {
		margin: 0;
		font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace;
		font-size: 36px;
		font-weight: 600;
	}

	.photography__note {
		margin: 0;
		color: var(--ink-muted);
		font-family: var(--font-sans);
		font-size: 15px;
	}
</style>
